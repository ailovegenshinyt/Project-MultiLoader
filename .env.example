# ── MultiLoader Environment Configuration ──────────────────────────────────
# Copy this file to .env and fill in your values

# ── Ngrok (Remote Access) ──────────────────────────────────────────────────
# Get your free token at: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=YOUR_NGROK_AUTHTOKEN

# ── Platform Cookies ───────────────────────────────────────────────────────
# Some platforms require cookies for private/age-gated content.
# Export cookies from your browser using a browser extension like:
#   - "Get cookies.txt LOCALLY" (Chrome/Firefox)
#   - "cookies.txt" (Chrome)
# Save the exported file and set the path below.
#
# NOTE: The global "cookies.txt" in the project root is used as fallback
#       for ALL platforms. Platform-specific cookies take priority.

# Instagram — needed for private profiles & stories
# INSTAGRAM_COOKIES=./cookies/instagram_cookies.txt

# TikTok — needed for age-restricted or region-locked content  
# TIKTOK_COOKIES=./cookies/tiktok_cookies.txt

# X (Twitter) — needed for age-gated / NSFW tweets
# X_COOKIES=./cookies/x_cookies.txt

# Facebook — needed for private videos & groups
# FACEBOOK_COOKIES=./cookies/facebook_cookies.txt

# Reddit — needed for NSFW or quarantined subreddit content
# REDDIT_COOKIES=./cookies/reddit_cookies.txt

# PornHub — needed for premium or age-verified content
# PORNHUB_COOKIES=./cookies/pornhub_cookies.txt

# Twitch — needed for subscriber-only VODs
# TWITCH_COOKIES=./cookies/twitch_cookies.txt

# Bilibili — needed for region-locked or premium content
# BILIBILI_COOKIES=./cookies/bilibili_cookies.txt

# Snapchat — needed for private stories
# SNAPCHAT_COOKIES=./cookies/snapchat_cookies.txt

# Pinterest — needed for private boards
# PINTEREST_COOKIES=./cookies/pinterest_cookies.txt

# LinkedIn — needed for LinkedIn Learning / private videos
# LINKEDIN_COOKIES=./cookies/linkedin_cookies.txt
